@echo off
echo  1. Allumage de l'usine (Docker)...
docker-compose up -d

echo  2. Attente de l'initialisation de Cassandra (40 secondes)...
timeout /t 40 /nobreak > NUL

echo 3. Creation de la base de donnees Cassandra...
docker exec -it cassandra cqlsh -e "CREATE KEYSPACE IF NOT EXISTS netshield WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};"
docker exec -it cassandra cqlsh -e "USE netshield; CREATE TABLE IF NOT EXISTS alertes ( \"Label\" text PRIMARY KEY, count bigint );"

echo  4. Demarrage de Hadoop sur le Master...
docker exec -d hadoop-master ./start-hadoop.sh

echo  Attente que Hadoop soit pret (15 secondes)...
timeout /t 15 /nobreak > NUL

echo  5. Lancement du job Spark Streaming en arriere-plan...
docker exec -d hadoop-master spark-submit --packages org.apache.spark:spark-sql-kafka-0-10_2.11:2.4.0 /src/spark_job.py

echo  6. Lancement du simulateur de trafic reseau (en arriere-plan)...
start /B python src\simulateur_reseau.py

echo  7. Lancement du Dashboard (Interface Graphique)...
streamlit run src\app.py